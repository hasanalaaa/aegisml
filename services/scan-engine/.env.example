# Local self-hosting defaults. Copy this file to .env and replace secrets.
DATABASE_URL=sqlite+aiosqlite:////data/aegisml.db
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
PORT=8000

# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Empty is safe for a one-off run (an ephemeral key is generated) but sessions
# will not survive a restart until you configure a persistent random value.
SECRET_KEY=
# /auth/sync stays unavailable when this is empty.
AUTH_SYNC_SECRET=

# Static analysis is the default. AI explanation is optional and never changes
# the deterministic verdict. Set true only when you intend to make network calls.
AEGISML_ENABLE_AI_ANALYSIS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Optional authenticated Hugging Face downloads.
HF_TOKEN=

# Conservative worker/admission limits for a developer workstation.
WORKER_MAX_JOBS=2
WORKER_JOB_TIMEOUT=900
WORKER_KEEP_RESULT=60
WORKER_JOB_EXPIRES=1800
WORKER_HEALTH_INTERVAL=60
ADMISSION_SMALL_PERMITS=4
ADMISSION_MEDIUM_PERMITS=2
ADMISSION_LARGE_PERMITS=1
